# ── Production (Hostinger/LiteSpeed) rules ──────────────────────────────────
# Origin full-page cache OFF: this is a dynamic COD store — one shopper's cart
# must never be served to another. Static assets stay cacheable below.
<IfModule LiteSpeed>
    CacheDisable public /
    CacheLookup off
</IfModule>

# Dynamic HTML is never cached by the CDN/browser; css/js/images/fonts are.
#
# The previous form of this block used `SetEnvIf Request_URI … GLOW_ASSET` with
# `Header set … env=!GLOW_ASSET`. Under LiteSpeed the env flag never took, so
# the no-cache header landed on EVERYTHING — verified in production: fonts,
# /build/assets/*.css and product JPEGs were all served
# `no-cache, private, must-revalidate`, i.e. re-downloaded on every page view.
# On the mobile connections this store actually runs on that is a real cost.
#
# FilesMatch does not depend on env propagation: the blanket no-cache applies,
# then the more specific block overrides it for static files.
<IfModule mod_headers.c>
    Header set Cache-Control "no-cache, private, must-revalidate"

    # Fingerprinted build output and fonts: safe to cache forever. Vite renames
    # on every content change, and a font file is replaced under a new name.
    <FilesMatch "\.(css|js|mjs|map|woff2?|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Uploaded media keeps its filename when the owner swaps a photo, so it gets
    # a long-but-finite TTL instead of `immutable` — a replaced product image
    # must not be stuck in caches for a year.
    <FilesMatch "\.(jpg|jpeg|png|webp|svg|gif|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Canonical host+scheme in ONE hop: any www or plain-http request 301s
    # straight to the https apex (chained redirects waste crawl budget).
    RewriteCond %{HTTP_HOST} ^www\.glowhalal\.com [NC,OR]
    RewriteCond %{HTTPS} !on
    RewriteCond %{HTTP_HOST} glowhalal\.com [NC]
    RewriteRule ^(.*)$ https://glowhalal.com/$1 [R=301,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
