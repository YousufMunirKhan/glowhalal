# ── Production (Hostinger/LiteSpeed) rules ──────────────────────────────────
#
# ⚠️  DO NOT `cp` THIS FILE OVER ~/domains/glowhalal.com/public_html/.htaccess
#
# The webroot copy carries a line this file deliberately does not:
#     AddHandler application/x-httpd-alt-php84___lsphp .php
# It forces PHP 8.4 (the hosting panel default is 8.2, which Laravel refuses to
# boot on). Overwriting the webroot file drops that line and every page 500s
# immediately — this happened on 16 Aug 2026.
#
# To ship a change from here: edit the webroot file in place, or copy it and
# re-prepend the handler line, then curl the homepage to confirm 200.
#
# Origin full-page cache OFF: this is a dynamic COD store — one shopper's cart
# must never be served to another. Static assets stay cacheable below.
<IfModule LiteSpeed>
    CacheDisable public /
    CacheLookup off
</IfModule>

# Dynamic HTML is never cached by the CDN/browser; css/js/images/fonts are.
#
# The previous form of this block used `SetEnvIf Request_URI … GLOW_ASSET` with
# `Header set … env=!GLOW_ASSET`. Under LiteSpeed the env flag never took, so
# the no-cache header landed on EVERYTHING — verified in production: fonts,
# /build/assets/*.css and product JPEGs were all served
# `no-cache, private, must-revalidate`, i.e. re-downloaded on every page view.
# On the mobile connections this store actually runs on that is a real cost.
#
# FilesMatch does not depend on env propagation: the blanket no-cache applies,
# then the more specific block overrides it for static files.
<IfModule mod_headers.c>
    Header set Cache-Control "no-cache, private, must-revalidate"

    # Fingerprinted build output and fonts: safe to cache forever. Vite renames
    # on every content change, and a font file is replaced under a new name.
    <FilesMatch "\.(css|js|mjs|map|woff2?|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Uploaded media keeps its filename when the owner swaps a photo, so it gets
    # a long-but-finite TTL instead of `immutable` — a replaced product image
    # must not be stuck in caches for a year.
    <FilesMatch "\.(jpg|jpeg|png|webp|svg|gif|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Canonical host+scheme in ONE hop: any www or plain-http request 301s
    # straight to the https apex (chained redirects waste crawl budget).
    RewriteCond %{HTTP_HOST} ^www\.glowhalal\.com [NC,OR]
    RewriteCond %{HTTPS} !on
    RewriteCond %{HTTP_HOST} glowhalal\.com [NC]
    RewriteRule ^(.*)$ https://glowhalal.com/$1 [R=301,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Trailing slashes are handled by LegacyRedirectMiddleware, NOT here.
    #
    # The stock Laravel slash rule used to live at this spot, and it ran before
    # PHP — so every slashed legacy URL (e.g. /product/x/feed/, and old
    # WordPress backlinks are usually written WITH the slash) burned hop #1 on
    # de-slashing and only reached the redirect table on hop #2. The middleware
    # already looks the redirect up on the slash-trimmed path and de-slashes
    # ordinary pages itself, so with the rule gone a slashed legacy URL 301s
    # ONCE, straight to its final target — the one-hop guarantee the migration
    # promised. The webserver rule also redirected POSTs (turning them into
    # GETs); the middleware only ever touches GET/HEAD.

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
